  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide the JWT access token in the header: 'Bearer <token>'"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65893a40498b3c3bc0cd32bb" },
          "name": { "type": "string", "example": "John Doe" },
          "username": { "type": "string", "example": "johndoe" },
          "email": { "type": "string", "format": "email", "example": "john.doe@example.com" },
          "role": { "type": "string", "example": "developer" },
          "bio": { "type": "string", "example": "Full-stack developer" },
          "avatar": { "type": "string", "example": "/uploads/avatars/avatar-123.png" },
          "phoneNumber": { "type": "string", "example": "1234567890" },
          "subscription": {
            "type": "object",
            "properties": {
              "plan": { "type": "string", "enum": ["FREE", "PRO"], "example": "PRO" },
              "startDate": { "type": "string", "format": "date-time" },
              "endDate": { "type": "string", "format": "date-time" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Snippet": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65893a40498b3c3bc0cd32cc" },
          "title": { "type": "string", "example": "Async Retry Helper" },
          "description": { "type": "string", "example": "Utility function to retry failed requests." },
          "language": { "type": "string", "example": "javascript" },
          "code": { "type": "string", "example": "const retry = async () => { ... };" },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["async", "javascript"] },
          "visibility": { "type": "string", "enum": ["public", "private"], "example": "public" },
          "createdBy": { "type": "string", "example": "65893a40498b3c3bc0cd32bb" },
          "bookmarks": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SnippetInput": {
        "type": "object",
        "required": ["title", "code"],
        "properties": {
          "title": { "type": "string", "example": "Reverse a String in JS" },
          "description": { "type": "string", "example": "A quick utility function to reverse a string" },
          "language": { "type": "string", "example": "javascript" },
          "code": { "type": "string", "example": "const reverse = str => str.split('').reverse().join('');" },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["string", "utility"] },
          "category": { "type": "string", "example": "65893a40498b3c3bc0cd32cc" },
          "visibility": { "type": "string", "enum": ["public", "private"], "default": "public", "example": "public" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65893a40498b3c3bc0cd32dd" },
          "snippet": { "type": "string", "example": "65893a40498b3c3bc0cd32cc" },
          "user": { "$ref": "#/components/schemas/User" },
          "comment": { "type": "string", "example": "Awesome snippet! Saved me time." },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65893a40498b3c3bc0cd32ee" },
          "user": { "type": "string", "example": "65893a40498b3c3bc0cd32bb" },
          "plan": { "type": "string", "enum": ["FREE", "PRO"], "example": "PRO" },
          "amount": { "type": "integer", "example": 49900 },
          "currency": { "type": "string", "example": "INR" },
          "orderId": { "type": "string", "example": "order_Px123456789" },
          "paymentId": { "type": "string", "example": "pay_Py987654321" },
          "status": { "type": "string", "enum": ["CREATED", "SUCCESS", "FAILED"], "example": "SUCCESS" },
          "verified": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string", "example": "Algorithms" },
          "description": { "type": "string", "example": "Data Structures & Algorithms" }
        }
      },
      "Language": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string", "example": "JavaScript" },
          "slug": { "type": "string", "example": "javascript" }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string", "example": "react" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Error message description" }
        }
      }
    }
  }
}
